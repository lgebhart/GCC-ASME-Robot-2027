
# Import path for file-path reliability
# Imports NumPy
# Import OpenCV for image processing
from pathlib import Path# Import OpenCV for image processing
import numpy as np
import cv2

# Build path to test image relative to file; must be PNG or JPEG
image_path = Path(__file__).parent / "assets" / "tesseract.jpg"

# Load image (-1 = unchanged, 0 = grayscale, 1 = color)
img = cv2.imread(str(image_path), 1)

# Resizes image
img = cv2.resize(img, (0, 0), fx=0.75, fy=0.75)

# Convert to grayscale for algorithm shape detection
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Corner detection algorithm by image, num corners, min quality, and min euclidean distance
corners = cv2.goodFeaturesToTrack(gray, 100, 0.01, 10)

# Display 2 corners to screen
corners = corners.astype(int)

for corner in corners:
    x, y = corner.ravel()
    cv2.circle(img, (x, y), 5, (255, 0, 0), -1)

# For 2D space (Pythagorean Theorem):
# (x1, y1) (x2, y2)
# sqrt((x2 - x1)^2 + (y2 - y1)^2)

# Draw randomly colored line between corners
for i in range(len(corners)):
    for j in range(i + 1, len(corners)):
        corner1 = tuple(corners[i][0])
        corner2 = tuple(corners[j][0])
        color = tuple(map(lambda x: int(x), np.random.randint(0, 255, size=3)))
        cv2.line(img, corner1, corner2, color, 1)

cv2.imshow('Frame', img)
cv2.waitKey(0)
cv2.destroyAllWindows()
